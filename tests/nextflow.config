/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// Stage repo fixtures into the per-test launch dir.
//
// nf-test runs each test from an ephemeral dir under .nf-test/, so relative paths
// inside committed samplesheets don't resolve. Symlinking <repo>/tests into the
// launch dir makes them resolve, with no rewriting of the samplesheet's contents.
//
// The `includeConfig({...}.call())` wrapper exists only because Nextflow's strict config
// parser bans top-level statements; including /dev/null is a documented no-op.
includeConfig ({
    def target = java.nio.file.Paths.get("${projectDir}/tests")
    def link = java.nio.file.Paths.get("${launchDir}/tests")

    if (!java.nio.file.Files.exists(link, java.nio.file.LinkOption.NOFOLLOW_LINKS)) {
        try {
            java.nio.file.Files.createSymbolicLink(link, target)
        }
        catch (e) {
            // e.g. Windows without developer mode / privilege to symlink
            throw new RuntimeException("Could not stage test fixtures: failed to symlink ${link} -> ${target}. " + "On Windows, enable Developer Mode or run as administrator.", e)
        }
    }

    return '/dev/null'
}.call())
