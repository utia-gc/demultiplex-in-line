manifest {
    author = 'Trevor F. Freeman'
    description = 'Demultiplex in-line indexes.'
    mainScript = 'main.nf'
    name = 'utia-gc/demultiplex-in-line'
    nextflowVersion = '!>=26.04'
}

params {
    /*
    ---------------------------------------------------------------------
        Demultiplexing behavior options
    ---------------------------------------------------------------------
    */
    // number errors allowed
    // passed directly to the `--errors` argument of cutadapt
    errors = 0

    /*
    ---------------------------------------------------------------------
        Read copying behavior
    ---------------------------------------------------------------------
    */
    // should reads be copied? I usually only turn this off for 
    skipCopyReads = false
}


singularity {
    enabled = true
    cacheDir = "${env('SCRATCHDIR')}/singularity"
    autoMounts = true
}


plugins {
    id 'nf-schema@2.7.2'
}


/*
---------------------------------------------------------------------
    Import config files
---------------------------------------------------------------------
*/
includeConfig 'conf/containers.config'
includeConfig 'conf/isaac.config'
