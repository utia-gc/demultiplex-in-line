manifest {
    author = 'Trevor F. Freeman'
    description = 'Demultiplex in-line indexes.'
    mainScript = 'main.nf'
    name = 'utia-gc/demultiplex-in-line'
    nextflowVersion = '!>=26.04'
}

params {
    samplesheet = null
    readStructures = null
    cliArgsFqtkDemux = ''
}


singularity {
    enabled = true
    cacheDir = "${env('SCRATCHDIR')}/singularity"
    autoMounts = true
}


plugins {
    id 'nf-schema@2.7.2'
}

workflow {
    output {
        mode = 'copy'
    }
}

/*
---------------------------------------------------------------------
    Import config files
---------------------------------------------------------------------
*/
includeConfig 'conf/containers.config'
includeConfig 'conf/isaac.config'

profiles {
    nf_test {
        includeConfig 'conf/nf_test.config'
    }
}
